        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@eslint/compat": "^1.2.7",
        "@mui/material": "^7.1.0",
        "@tanstack/query-async-storage-persister": "^5.83.0",
        "@tanstack/react-query": "^5.75.2",
        "@tanstack/react-query-devtools": "^5.69.0",
        "@tanstack/react-query-persist-client": "^5.75.2",
        "axios": "^1.8.4",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-prettier": "^5.2.3",
        "fast-deep-equal": "^3.1.3",
        "geopf-extensions-openlayers": "1.0.0-beta.8",
        "geoportal-access-lib": "^3.4.6",
        "i18nifty": "^3.2.6",
        "jspdf": "^4.2.0",
        "lint-staged": "^15.5.0",
        "oidc-spa": "^10.2.1",
        "ol": "^10.8.0",
        "prettier": "^3.5.3",
        "react": "^19.0.0",
        "react-csv": "^2.2.2",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.4.1",
        "zustand": "^5.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@types/proj4": "^2.5.6",
        "@types/react": "^19.0.10",
        "@types/react-csv": "^1.1.10",
        "@types/react-dom": "^19.0.4",
        "@types/react-router-dom": "^5.3.3",
        "@vitejs/plugin-react-swc": "^3.8.0",
        "eslint": "^9.22.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^15.15.0",
        "husky": "^9.1.7",
        "sass-embedded": "^1.89.2",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.27.0",
        "vite": "^6.2.0",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "lint-staged": {
        "*": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern",
        "*.{js,ts,jsx,tsx}": "eslint"
    }
}
