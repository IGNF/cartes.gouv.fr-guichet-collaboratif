{
    "name": "vite-project",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "predev": "react-dsfr update-icons",
        "dev": "vite",
        "prebuild": "react-dsfr update-icons",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "check-types": "tsc -b",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "prepare": "husky"
    },
    "dependencies": {
        "@codegouvfr/react-dsfr": "1.32.4",
        "@commitlint/cli": "21.1.0",
        "@commitlint/config-conventional": "21.1.0",
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.1",
        "@eslint/compat": "2.1.0",
        "@mui/material": "9.1.2",
        "@tanstack/query-async-storage-persister": "5.101.2",
        "@tanstack/react-query": "5.101.2",
        "@tanstack/react-query-devtools": "5.101.2",
        "@tanstack/react-query-persist-client": "5.101.2",
        "axios": "1.18.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.6",
        "geopf-extensions-openlayers": "1.0.0-beta.12",
        "geoportal-access-lib": "3.4.6",
        "i18nifty": "4.0.6",
        "lint-staged": "17.0.8",
        "oidc-spa": "10.2.3",
        "ol": "10.9.0",
        "pdf-lib": "1.17.1",
        "prettier": "3.9.4",
        "proj4": "2.20.9",
        "react": "19.2.7",
        "react-csv": "2.2.2",
        "react-dom": "19.2.7",
        "react-router-dom": "7.18.1",
        "zustand": "5.0.14"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/react": "19.2.17",
        "@types/react-csv": "1.1.10",
        "@types/react-dom": "19.2.3",
        "@types/react-router-dom": "5.3.3",
        "@vitejs/plugin-react": "6.0.3",
        "eslint": "10.6.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.3",
        "globals": "17.7.0",
        "husky": "9.1.7",
        "sass-embedded": "1.100.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "8.62.1",
        "vite": "8.1.0"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "lint-staged": {
        "*": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern",
        "*.{js,ts,jsx,tsx}": "eslint"
    }
}
