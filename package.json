{
    "name": "vite-project",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "predev": "react-dsfr update-icons",
        "dev": "vite",
        "prebuild": "react-dsfr update-icons",
        "build": "node node_modules/typescript-7/bin/tsc -b && vite build",
        "preview": "vite preview",
        "check-types": "node node_modules/typescript-7/bin/tsc -b",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "prepare": "husky"
    },
    "dependencies": {
        "@codegouvfr/react-dsfr": "1.35.0",
        "@commitlint/cli": "21.2.3",
        "@commitlint/config-conventional": "21.2.3",
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.1",
        "@eslint/compat": "2.1.1",
        "@mui/material": "9.5.0",
        "@tanstack/query-async-storage-persister": "5.104.2",
        "@tanstack/react-query": "5.104.2",
        "@tanstack/react-query-devtools": "5.104.2",
        "@tanstack/react-query-persist-client": "5.104.2",
        "@turf/boolean-intersects": "7.4.0",
        "@turf/turf": "7.4.0",
        "axios": "1.20.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.6",
        "geopf-extensions-openlayers": "1.0.0-beta.15",
        "geoportal-access-lib": "3.4.7",
        "i18nifty": "4.0.6",
        "lint-staged": "17.6.0",
        "oidc-spa": "10.2.18",
        "ol": "10.11.0",
        "pdf-lib": "1.17.1",
        "prettier": "3.9.10",
        "proj4": "2.22.0",
        "react": "19.3.0",
        "react-csv": "2.2.2",
        "react-dom": "19.3.0",
        "react-router": "8.4.0",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/react": "19.3.0",
        "@types/react-csv": "1.1.10",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "eslint": "10.12.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.7",
        "globals": "17.13.0",
        "husky": "9.1.7",
        "sass-embedded": "1.105.1",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-7": "npm:typescript@7.0.2",
        "typescript-eslint": "8.71.2",
        "vite": "8.3.4"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "lint-staged": {
        "*": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern",
        "*.{js,ts,jsx,tsx}": "eslint"
    },
    "engines": {
        "node": ">=26.0.0 <27.0.0",
        "npm": ">=12.0.0"
    }
}
